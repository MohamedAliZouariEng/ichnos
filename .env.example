# Ichnos configuration. Create your own copy with: cp .env.example .env
# .env is git-ignored and never copied into an image. Never commit real tokens.

# GitHub fine-grained personal access token (ADR-0004).
# Repository access: only the repositories Ichnos should read.
# Permissions, all read-only: Contents, Issues, Pull requests (Metadata is added automatically).
ICHNOS_GITHUB_TOKEN=

# Port for the web UI on this machine. The UI listens on 127.0.0.1 only.
ICHNOS_WEB_PORT=8765

# Model providers (ADR-0006). Used from Phase 3; empty values mean "not set".
ICHNOS_LLM_PROVIDER=
ICHNOS_LLM_MODEL=
ICHNOS_LLM_BASE_URL=
ICHNOS_EMBEDDING_PROVIDER=
ICHNOS_EMBEDDING_MODEL=
ICHNOS_EMBEDDING_BASE_URL=

# To use the bundled Ollama, start with: docker compose --profile ollama up
# ICHNOS_LLM_PROVIDER=ollama
# ICHNOS_LLM_BASE_URL=http://ollama:11434
